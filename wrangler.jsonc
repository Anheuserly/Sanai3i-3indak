{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanai3i-3indak",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-14",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "sanai3i-3indak.amcmep.in",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_PROJECT_SCOPE": "sanai3i_3indak"
  },
  "workers_dev": true
}
